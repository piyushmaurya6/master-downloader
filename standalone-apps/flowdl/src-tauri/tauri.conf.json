{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlowDL",
  "version": "1.0.0",
  "identifier": "com.flowdl.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FlowDL",
        "width": 1100,
        "height": 760,
        "minWidth": 850,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: http: data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "FlowDL",
    "copyright": "Copyright © 2026 FlowDL",
    "category": "Utility",
    "shortDescription": "Self-contained Windows video and audio downloader powered by yt-dlp and FFmpeg",
    "longDescription": "FlowDL is a self-contained, modern, lightweight Windows desktop application that bundles yt-dlp and FFmpeg to download videos and audio from YouTube and supported websites with zero manual setup.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/bin/*": "bin/",
      "resources/licenses/*": "licenses/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    }
  }
}
